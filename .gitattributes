# Normalize line endings for everyone, regardless of OS/editor settings.
* text=auto eol=lf

*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.cfg text eol=lf
*.sh text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# Windows-only scripts, if any get added later, keep CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary/media — never diff or line-ending-convert these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.mp4 binary
*.mov binary
*.mkv binary
